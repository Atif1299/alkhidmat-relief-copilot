# Production env template (GCP Cloud Run / local reference)
# Never commit real secrets. Secrets on GCP live in Secret Manager.

# LLM (Alibaba DashScope)
LLM_MODE=qwen
DASHSCOPE_API_KEY=set_via_secret_manager
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Cloud Run api — set to web service origin after web is deployed
CORS_ORIGINS=https://relief-web-XXXX.asia-south1.run.app

# Cloud SQL — deploy script sets socket form for Cloud Run:
# DATABASE_URL=postgresql+psycopg://aiddesk:PASSWORD@/aiddesk?host=/cloudsql/x-saas-488416:asia-south1:relief-pg

# Local Compose only (not GCP):
# DATABASE_URL=sqlite:////app/data/relief.db
# CHECKPOINT_PATH=/app/data/checkpoints.db
# CORS_ORIGINS=*
