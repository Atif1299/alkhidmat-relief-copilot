# Production / ECS env — copy to `.env` on the server (never commit secrets).
# cp .env.production.example .env

# LLM
LLM_MODE=qwen
DASHSCOPE_API_KEY=replace_with_your_key
DASHSCOPE_MODEL=qwen-plus
# Use your working Model Studio base (intl or Beijing workspace URL)
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Same-origin via nginx — allow all origins or set your public URL
CORS_ORIGINS=*

# SQLite inside Docker volume (set by compose; override only if needed)
# DATABASE_URL=sqlite:////app/data/relief.db
# CHECKPOINT_PATH=/app/data/checkpoints.db
