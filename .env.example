# Alkhidmat Relief Copilot — environment (Tier 3)

# LLM: mock | qwen
LLM_MODE=mock
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=1536

# Tier 3 target DB = Postgres (docker compose service `db`)
DATABASE_URL=postgresql+psycopg://aiddesk:aiddesk@localhost:5432/aiddesk

# Auth
JWT_SECRET=dev-change-me-aiddesk-jwt-secret-min-32-chars
AUTH_DISABLED=false

CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
